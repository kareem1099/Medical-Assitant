# Required API Keys
GEMINI_API_KEY=your_gemini_api_key_here
NCBI_EMAIL=your_email@example.com
NCBI_API_KEY=your_ncbi_api_key_here  # Optional, higher PubMed rate limit

# MongoDB - stores projects, file metadata, and chunk text
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=medical_assistant

# Qdrant - vector database for chunk embeddings
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                      # Optional, only needed for Qdrant Cloud
QDRANT_COLLECTION_NAME=medical_chunks

# Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.1

# Chunking Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval Parameters
TOP_K=5
SCORE_THRESHOLD=0.5

# Logging
LOG_FILE=./logs/app.log
