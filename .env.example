# LLM provider: "cohere" or "gemini"
LLM_PROVIDER=cohere
COHERE_API_KEY=your_cohere_api_key_here
LLM_MODEL=command-a-03-2025
LLM_TEMPERATURE=0.1
GEMINI_API_KEY=

# PubMed (NCBI asks every request to identify itself with an email).
# Optional fallback - users can also enter their email in the app's Settings.
NCBI_EMAIL=
NCBI_API_KEY=

# MongoDB - users, workspaces, file metadata, chunk text, conversations
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=medical_assistant

# Qdrant - vector database for chunk embeddings
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=medical_chunks
QDRANT_TIMEOUT=30

# Embeddings and retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
SCORE_THRESHOLD=0.2

# Web server
APP_HOST=127.0.0.1
APP_PORT=7860
# Long random string that signs session cookies; keeps users signed in across restarts.
APP_SECRET=
MAX_UPLOAD_MB=25

# Sign-up is Google-only. Create an OAuth 2.0 Client ID (type "Web application")
# in Google Cloud Console > APIs & Services > Credentials, and add
# http://localhost:7860 (and http://localhost:5173 for `npm run dev`) to
# "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Email for password-reset codes. Leave SMTP_HOST empty in
# development: the codes are then printed in the server console and log.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<16-character App Password>, SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# true = implicit TLS (port 465); false = STARTTLS (port 587)
SMTP_SSL=false

# Logging
LOG_FILE=./logs/app.log
